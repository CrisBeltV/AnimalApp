# Plantilla de variables de entorno. Copiala a .env.local y poné tus valores.
# .env.local no se sube a git. Este archivo sí, y nunca debe llevar claves reales.
# Solo las variables EXPO_PUBLIC_ llegan a la app, y quedan visibles dentro de ella:
# nunca pongas acá service_role ni secret de Supabase.

# Clave de MapTiler (maptiler.com -> Account -> API keys)
EXPO_PUBLIC_MAPTILER_KEY=
