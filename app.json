{
  "expo": {
    "name": "Animaapp",
    "slug": "animaapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.animaapp.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.animaapp.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Animaapp",
      "themeColor": "#E1EEFB",
      "backgroundColor": "#F3F5F8"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Animaapp usa la cámara para fotografiar el carnet de vacunas y las cajas de medicamentos de tu mascota.",
          "photosPermission": "Animaapp usa tus fotos para guardar el carnet de vacunas y las cajas de medicamentos de tu mascota."
        }
      ],
      "expo-notifications",
      "expo-status-bar"
    ],
    "scheme": "animaapp",
    "splash": {
      "backgroundColor": "#F3F5F8"
    }
  }
}
